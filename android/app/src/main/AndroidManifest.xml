<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Screen & Lock's brightness and "turn off after" really set Android's, through
         com.palm.display/control. Granted at install while Lunacy targets API 21; from
         API 23 this needs the user's consent (a ratchet item, docs/architecture.md). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- webOS's /media/internal is the user's own storage, and apps read and wrote it freely.
         Android's shared folders are mapped into it (UserFiles.kt). Granted at install while
         Lunacy targets API 21; a ratchet item for API 23 and later. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <application
        android:label="Lunacy"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name=".shell.ShellActivity" android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
