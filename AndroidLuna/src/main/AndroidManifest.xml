<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Before Android 8, how a webOS app is pinned to Android's own home screen
         (shell/HomeScreenPins.kt). A normal permission. -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Screen & Lock's brightness and "turn off after" really set Android's, through
         com.palm.display/control. Granted at install on Android 5; from Android 6 the user
         grants it on Android's own screen, which DisplayService opens (Docs/architecture.md). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Screen & Lock's opt-in to Android's home and lock screen wallpaper following webOS's
         (HostWallpaper.kt). A normal permission, granted at install on every version. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- PDL_Vibrate, for PDK apps (PdkWindow.onPdl). A normal permission; without it the
         call was refused and nothing buzzed. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- display/control/setState "on": the SDK's palm-launch wakes the screen with it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The status bar's Bluetooth icon: whether the adapter is on and connected. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- webOS's /media/internal is the user's own storage, and apps read and wrote it freely.
         Android's shared folders are mapped into it (UserFiles.kt). Granted at install on
         Android 5; from Android 6 the shell asks for it at startup. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- The launcher's delete badge on an Android app hands it to Android's uninstaller
         (AndroidApps.uninstall). From a target of 28 (the arm64 flavour) ACTION_DELETE is
         silently dropped without this; the user still confirms on Android's own dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- An .apk the user opens from the Web app's downloads goes to Android's installer
         (WebosLinks.androidPackage); from Android 8 the installer needs this to accept it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:label="Lunacy"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:resizeableActivity="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Lunacy">
        <!-- networkSecurityConfig: from a target of 28, Android blocks plain http unless the
             app says otherwise; webOS apps and the loopback media server use it freely
             (Docs/architecture.md, "Unrestricted HTTP", a ratchet item). Android 5 and 6
             ignore the attribute, and targets below 28 allowed cleartext anyway. -->
        <!-- Safe Browsing: on from a target of 27, it would put Chrome's red interstitial in
             a card for a flagged site, which a webOS device never did. Off (ratchet item). -->
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
        <!-- resizeableActivity: from a target of 24, Android runs an app in split screen
             unless it says no. Lunacy is the whole screen, as the shell was on a device;
             Android 5 has no split screen and ignores the attribute. -->
        <!-- supports_size_changes: a foldable's two screens are still the whole screen, and
             a non-resizable app moved between them is put in size compat, where One UI asks
             to restart it ("This app can't be resized while running"). This tells Android
             the shell takes the new size live (configChanges below), as it does a rotation,
             while split screen stays off. Android 12 and later; older ones ignore it. -->
        <meta-data android:name="android.supports_size_changes" android:value="true" />
        <!-- The splash theme is the shell's alone: its windowBackground is what Android
             paints while the process starts. ShellActivity clears it once it has drawn. -->
        <activity android:name=".shell.ShellActivity" android:exported="true"
            android:theme="@style/Theme.Lunacy.Splash"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|keyboard|screenLayout|fontScale|density|uiMode|layoutDirection">
            <!-- fontScale, density, uiMode: none of them changes what the shell draws (it
                 scales to the screen itself), and each would otherwise re-create the activity
                 and end every running app. A language change still does, as changing the
                 language restarted Luna on a device. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Proof of concept: Lunacy as Android's home screen. Android offers it as a
                 launcher; Home then comes here (onNewIntent). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Android's screen saver, which Android 5 calls Daydream, showing webOS's
             Exhibition mode. The system is the only thing allowed to start it
             (BIND_DREAM_SERVICE); its label and the launcher icon are what Settings lists. -->
        <!-- /media/internal's files, lent to the Android app a video is handed to (WebosLinks). -->
        <provider android:name=".card.MediaFiles"
            android:authorities="org.webosarchive.lunacy.media"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service android:name=".shell.ExhibitionDream"
            android:exported="true"
            android:label="Lunacy Exhibition"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>
        <!-- Android's notifications, as webOS dashboards (card/AndroidNotifications.kt). Only
             Android may bind it, and only once the owner allows it on Android's Notification
             access screen; until then Lunacy sees nothing. -->
        <service android:name=".card.AndroidNotificationListener"
            android:exported="true"
            android:label="Lunacy"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- The gear beside that entry: opens Palm's Exhibition app, which owns the choice. -->
        <activity android:name=".shell.ExhibitionSettingsActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Shortcuts pinned by other apps (a browser's "Add to Home screen") while Lunacy is
             the home screen: Android 8's pin request, and the broadcast before it, which only
             apps holding INSTALL_SHORTCUT can send (shell/PinnedShortcuts.kt). -->
        <activity android:name=".shell.PinShortcutActivity" android:exported="true"
            android:excludeFromRecents="true" android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
        <receiver android:name=".shell.InstallShortcutReceiver" android:exported="true"
            android:permission="com.android.launcher.permission.INSTALL_SHORTCUT">
            <intent-filter>
                <action android:name="com.android.launcher.action.INSTALL_SHORTCUT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
