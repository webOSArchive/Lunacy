<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Screen & Lock's brightness and "turn off after" really set Android's, through
         com.palm.display/control. Granted at install while Lunacy targets API 21; from
         API 23 this needs the user's consent (a ratchet item, Docs/architecture.md). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- webOS's /media/internal is the user's own storage, and apps read and wrote it freely.
         Android's shared folders are mapped into it (UserFiles.kt). Granted at install while
         Lunacy targets API 21; a ratchet item for API 23 and later. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <application
        android:label="Lunacy"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Lunacy">
        <!-- The splash theme is the shell's alone: its windowBackground is what Android
             paints while the process starts. ShellActivity clears it once it has drawn. -->
        <activity android:name=".shell.ShellActivity" android:exported="true"
            android:theme="@style/Theme.Lunacy.Splash"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Android's screen saver, which Android 5 calls Daydream, showing webOS's
             Exhibition mode. The system is the only thing allowed to start it
             (BIND_DREAM_SERVICE); its label and the launcher icon are what Settings lists. -->
        <service android:name=".shell.ExhibitionDream"
            android:exported="true"
            android:label="Lunacy Exhibition"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>
        <!-- The gear beside that entry: opens Palm's Exhibition app, which owns the choice. -->
        <activity android:name=".shell.ExhibitionSettingsActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
