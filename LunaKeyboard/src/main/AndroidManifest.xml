<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Text Assist: shortcuts and learned words are Android's personal dictionary, which
         Android 6 and later lets only the current keyboard read; and the correction alert
         can be a buzz instead of the plop. -->
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 11 and later only let an app see the providers it names: the personal
         dictionary's. Earlier Android ignores this. -->
    <queries>
        <provider android:authorities="user_dictionary" />
    </queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true">
        <!-- The keyboard itself. Only the input-method system may bind it. -->
        <service android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
        <!-- Sideloaded keyboards have to be enabled and then chosen by hand; this activity is
             both the launcher entry and the gear beside the entry in Language & input. -->
        <activity android:name=".SetupActivity" android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
